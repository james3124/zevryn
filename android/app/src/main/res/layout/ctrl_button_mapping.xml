<?xml version="1.0" encoding="utf-8"?>
<!-- Button mapping screen: a list of actions with their currently bound key.
     Tapping a row shows a "Press a key..." toast; no real capture or native
     call is performed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ctrl_button_mapping_header"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ctrl_button_mapping_hint"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:paddingStart="16dp"
        android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ctrlBindingRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>
