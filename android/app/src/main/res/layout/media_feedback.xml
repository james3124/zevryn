<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/media_feedback_header"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/media_feedback_hint"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:paddingStart="16dp"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/feedbackInput"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="12dp"
        android:gravity="top|start"
        android:background="@drawable/card_background"
        android:hint="@string/media_feedback_input_hint"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:inputType="textMultiLine"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/feedbackSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:minHeight="44dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/media_feedback_send"
        android:textColor="@color/textPrimary"
        android:textAllCaps="false"
        android:background="@drawable/card_background" />
</LinearLayout>
