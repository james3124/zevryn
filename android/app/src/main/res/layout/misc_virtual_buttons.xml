<?xml version="1.0" encoding="utf-8"?>
<!-- "Virtual Buttons" tab: a focusable on-screen control overlay preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/misc_virtual_header"
        android:textColor="@color/textPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/misc_virtual_hint"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:paddingStart="16dp"
        android:paddingBottom="8dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/miscOverlaySwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="44dp"
        android:checked="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="@string/misc_overlay_show"
        android:textColor="@color/textPrimary"
        android:textSize="14sp" />

    <!-- Everything below this point is the toggleable overlay surface. -->
    <FrameLayout
        android:id="@+id/miscOverlayRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:contentDescription="@string/misc_virtual_surface_desc">

            <!-- D-pad: up / left+center+right / down. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/miscDpadUp"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:background="@drawable/card_background"
                    android:text="@string/misc_dpad_up"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/miscDpadLeft"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_dpad_left"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miscDpadCenter"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_dpad_center"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miscDpadRight"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_dpad_right"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/miscDpadDown"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:background="@drawable/card_background"
                    android:text="@string/misc_dpad_down"
                    android:textColor="@color/textPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Spacer between the two clusters. -->
            <View
                android:layout_width="32dp"
                android:layout_height="match_parent" />

            <!-- Action buttons: A / B / X / Y. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/miscBtnX"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_btn_x"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miscBtnY"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_btn_y"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/miscBtnA"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_btn_a"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/miscBtnB"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:background="@drawable/card_background"
                        android:text="@string/misc_btn_b"
                        android:textColor="@color/textPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
